{
  "manifest_version": 3,
  "name": "Bunny Buddy",
  "version": "1.0.0",
  "description": "A screen-share study tutor with a pixel bunny.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "identity", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bunny Buddy",
    "default_icon": "assets/mascot/mascot.png"
  },
  "side_panel": {
    "default_path": "session/session.html"
  },
  "icons": {
    "128": "assets/mascot/mascot.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/mascot.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/mascot/mascot.png", "content/mascot.css", "offscreen/pcm-processor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
