# Copy to web/.env.local and fill in the keys you have.

# Local demo login for the extension ("Continue in dev mode") and the website.
DEV_AUTH_BYPASS=1

# Auth0 regular web app for the website, same tenant and API audience as the extension.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=

# Gemini Live text model. The extension connects with a short-lived token minted here.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# ElevenLabs. The extension opens the TTS socket; this route only hands the key to a logged-in client.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_CALM=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_VOICE_STRICT=onwK4e9ZLuTAKqWW03F9

# Tiger Data / Timescale connection string. Leave empty to use web/data/store.json.
DATABASE_URL=
